# Copy to android/key.properties (git-ignored) and fill in your own values.
# Generate a keystore once with:
#   keytool -genkey -v -keystore C:\keys\fintrack-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias fintrack
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=fintrack
storeFile=C:/keys/fintrack-release.jks
